# ══════════════════════════════════════════════════════════════════════════════
# Rudood — Environment Variables Template
# Copy this file to .env.production on your VPS and fill in real values.
# Never commit .env.production or .env.local to Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Public vars (baked into the JS bundle at build time) ──────────────────────
# n8n webhook — receives the contact form submissions
NEXT_PUBLIC_N8N_FORM_URL=https://n8n.yourdomain.com/webhook/YOUR_WEBHOOK_ID

# Chatwoot Public API (used in the TryNow live-chat demo)
# BASE_URL  → your self-hosted Chatwoot instance URL
# INBOX_ID  → the PUBLIC inbox identifier (alphanumeric), found in:
#             Chatwoot → Settings → Inboxes → API Channel → Inbox Identifier
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat.yourdomain.com
NEXT_PUBLIC_CHATWOOT_INBOX_ID=your_public_inbox_identifier

# ── Server-side secrets (runtime only, never exposed to the browser) ──────────
# Chatwoot Admin API — used by the /api/chat/* server routes
# TOKEN → Chatwoot → Profile → Access Token
# ACCOUNT_ID → numeric ID in the Chatwoot URL (e.g. /app/accounts/1/...)
# INBOX_ID   → numeric inbox ID (Settings → Inboxes)
CHATWOOT_BASE_URL=https://chat.yourdomain.com
CHATWOOT_API_TOKEN=your_agent_api_access_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=27
